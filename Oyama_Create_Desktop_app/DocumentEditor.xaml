<Window x:Class="Oyama.Create.Desktop.DocumentEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Document studio · Oyama Create" Width="1380" Height="900" MinWidth="780" MinHeight="600"
 WindowStartupLocation="CenterOwner" Background="#E9ECF0" FontFamily="Segoe UI" Foreground="#263247">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE1E8"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE1E8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="3"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#6B7586"/><Setter Property="Margin" Value="0,16,0,7"/></Style>
 </Window.Resources>
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Save" Executed="SaveDocument"/></Window.CommandBindings>
 <Window.InputBindings><KeyBinding Command="ApplicationCommands.Save" Gesture="Ctrl+S"/></Window.InputBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="#FFFFFF" BorderBrush="#DCE1E8" BorderThickness="0,0,0,1" Padding="18,8">
   <DockPanel>
    <Button DockPanel.Dock="Left" Content="‹  Library" Click="BackToLibrary" ToolTip="Close document and return to library"/>
    <Button DockPanel.Dock="Right" Content="Save to library" Click="SaveDocument" Background="#185ABD" Foreground="White" Padding="20,8"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
     <TextBlock Text="Oyama Create  /" Foreground="#738096" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <TextBox x:Name="DocumentTitle" Text="Untitled letter" MaxLength="160" Width="240" FontSize="15" FontWeight="SemiBold" BorderThickness="0" Padding="4" AutomationProperties.Name="Document title" TextChanged="MarkDirty"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#D4DAE3" BorderThickness="0,0,0,1" Padding="18,9">
   <StackPanel>
    <TextBlock Text="HOME" FontSize="11" FontWeight="SemiBold" Foreground="#185ABD" Margin="4,0,0,8"/>
    <WrapPanel>
     <Button Content="↶" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"/>
     <Button Content="↷" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"/>
     <Separator Width="1" Margin="10,0"/>
     <ComboBox x:Name="FontPicker" Width="154" SelectedIndex="0" SelectionChanged="ChangeFont" AutomationProperties.Name="Font family"><ComboBoxItem Content="Calibri"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Georgia"/><ComboBoxItem Content="Times New Roman"/></ComboBox>
     <ComboBox x:Name="SizePicker" Width="65" SelectedIndex="2" SelectionChanged="ChangeFontSize" AutomationProperties.Name="Font size in points"><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="24"/><ComboBoxItem Content="36"/></ComboBox>
     <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold"/>
     <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic"/>
     <ToggleButton x:Name="UnderlineButton" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline"><TextBlock Text="U" TextDecorations="Underline"/></ToggleButton>
     <Separator Width="1" Margin="10,0"/>
     <Button Content="Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align left"/>
     <Button Content="Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align center"/>
     <Button Content="Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" ToolTip="Align right"/>
     <Button Content="• List" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="Bulleted list"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="228"/></Grid.ColumnDefinitions>
   <Border Background="#F8F9FB" BorderBrush="#D4DAE3" BorderThickness="0,0,1,0">
    <StackPanel Margin="4,14"><Button Content="T" FontSize="18" FontWeight="SemiBold" Click="FocusText" ToolTip="Text tool" AutomationProperties.Name="Text tool"/><Button Content="☷" Click="ToggleInspector" ToolTip="Show or hide page properties" AutomationProperties.Name="Toggle properties"/></StackPanel>
   </Border>
   <ScrollViewer x:Name="CanvasScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="32,24">
    <StackPanel HorizontalAlignment="Center">
     <Border Background="#F5F6F8" Height="24" Margin="0,0,0,14" BorderBrush="#CCD3DD" BorderThickness="1" Width="{Binding ElementName=Paper, Path=ActualWidth}">
      <TextBlock Text="DOCUMENT CANVAS" FontSize="10" Foreground="#79869A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     </Border>
     <Border x:Name="Paper" Background="White" Width="816" MinHeight="1056" VerticalAlignment="Top">
      <Border.LayoutTransform><ScaleTransform x:Name="PageScale" ScaleX="0.85" ScaleY="0.85"/></Border.LayoutTransform>
      <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
      <RichTextBox x:Name="Editor" BorderThickness="0" Background="White" Padding="0" MinHeight="1056" VerticalScrollBarVisibility="Disabled" AcceptsTab="True" IsDocumentEnabled="False" SpellCheck.IsEnabled="True" TextChanged="ContentChanged" SelectionChanged="SelectionChanged" AutomationProperties.Name="Document canvas">
       <FlowDocument FontFamily="Calibri" FontSize="16" PagePadding="96" ColumnWidth="10000"><Paragraph/></FlowDocument>
      </RichTextBox>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="Inspector" Grid.Column="2" Background="#FAFBFC" BorderBrush="#D4DAE3" BorderThickness="1,0,0,0" Padding="20">
    <StackPanel>
     <TextBlock Text="Properties" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="DOCUMENT" Style="{StaticResource Label}"/>
     <TextBlock Text="Letter" FontSize="14"/>
     <TextBlock Text="PAGE SIZE" Style="{StaticResource Label}"/>
     <ComboBox x:Name="PagePicker" SelectedIndex="0" SelectionChanged="ChangePage" AutomationProperties.Name="Page size"><ComboBoxItem Content="US Letter · 8.5 × 11 in"/><ComboBoxItem Content="A4 · 210 × 297 mm"/></ComboBox>
     <TextBlock Text="MARGINS" Style="{StaticResource Label}"/>
     <ComboBox x:Name="MarginPicker" SelectedIndex="0" SelectionChanged="ChangePage" AutomationProperties.Name="Page margins"><ComboBoxItem Content="Normal · 1 in"/><ComboBoxItem Content="Narrow · 0.5 in"/><ComboBoxItem Content="Wide · 1.25 in"/></ComboBox>
     <TextBlock Text="WORKSPACE" Style="{StaticResource Label}"/>
     <TextBlock Text="Text flows down the canvas as you write. Page size sets the writing width; print pagination comes in a later step." FontSize="12" Foreground="#738096" TextWrapping="Wrap" LineHeight="19"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#D4DAE3" BorderThickness="0,1,0,0" Padding="16,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Zoom" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <Slider x:Name="Zoom" Minimum="40" Maximum="150" Value="85" Width="110" ValueChanged="ChangeZoom" AutomationProperties.Name="Canvas zoom"/>
     <TextBlock x:Name="ZoomLabel" Text="85%" Width="40" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="DocumentStatus" Text="New document · Not saved" FontSize="11" Foreground="#68758A" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>

