<Window x:Class="Oyama.Create.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Oyama Create" Height="800" Width="1200" MinHeight="560" MinWidth="640"
 WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontFamily="Segoe UI" Foreground="#202B3D">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#26364D"/><Setter Property="BorderBrush" Value="#DDE2EA"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#185ABD"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E3E7ED" BorderThickness="0,0,0,1" Padding="24,0">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#185ABD" CornerRadius="7" Width="30" Height="30" Margin="0,0,12,0"><TextBlock Text="O" Foreground="White" FontWeight="SemiBold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="Oyama Create" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text=" /  Library" Foreground="#68758A" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#E3E7ED" BorderThickness="0,0,0,1" Padding="24,10">
   <StackPanel Orientation="Horizontal">
    <Button Click="NewDocument" Background="#185ABD" Foreground="White" BorderBrush="#185ABD" AutomationProperties.Name="New document" ToolTip="Create a blank letter">
     <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="21" Margin="0,-4,8,-3"/><TextBlock Text="New document" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <Button Click="ImportDocument" Margin="10,0,0,0" ToolTip="Open a text file and add it to your library" Content="Open document…"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,28">
    <TextBlock Text="Your library" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="A space for your letters. Create something new, or pick up where you left off." Foreground="#667388" FontSize="14" Margin="0,8,0,24" TextWrapping="Wrap"/>
    <TextBlock Text="LETTERS" FontSize="11" FontWeight="SemiBold" Foreground="#667388" Margin="0,0,0,12"/>
    <WrapPanel x:Name="Cards"/>
    <Border x:Name="EmptyState" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="10" Padding="32" Margin="0,12,0,0">
     <StackPanel><TextBlock Text="Your first letter starts here" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Use + New document to create a letter, or open a .txt file. Your saved letters will appear here with previews." Foreground="#667388" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="3" Background="White" BorderBrush="#E3E7ED" BorderThickness="0,1,0,0" Padding="24,6"><TextBlock x:Name="Status" Text="Local library · Saved on this computer" FontSize="11" Foreground="#667388"/></Border>
 </Grid>
</Window>
