<Window x:Class="OyamaPrint.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to OyamaPrint" Width="900" Height="570" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="White">
  <Grid Background="White">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.9*" MinWidth="300" />
      <ColumnDefinition Width="1.1*" MinWidth="390" />
    </Grid.ColumnDefinitions>

    <Border Background="#062D52" Padding="48">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Image Source="pack://application:,,,/OyamaPrint;component/Assets/oyama-crm-logo.png" Width="250" HorizontalAlignment="Left" Stretch="Uniform" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="PRINT WITH PURPOSE" Foreground="#75C4FF" FontSize="12" FontWeight="Bold" />
          <TextBlock Text="Every document, ready to make an impact." Foreground="White" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,14" LineHeight="39" />
          <TextBlock Text="Create letters, receipts, labels, envelopes, and reports with your organization’s trusted Oyama CRM data and branding." Foreground="#D8E8F6" FontSize="15" TextWrapping="Wrap" LineHeight="23" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Secure connection  •  CRM permissions honored" Foreground="#A9C6DE" FontSize="12" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="64,44" Background="White">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" MaxWidth="390">
        <TextBlock Text="Welcome to OyamaPrint" FontSize="28" FontWeight="SemiBold" Foreground="#152638" />
        <TextBlock Text="Sign in with your Oyama CRM account to open your print workspace." Foreground="#5C6B7A" TextWrapping="Wrap" Margin="0,8,0,24" FontSize="14" />

        <TextBlock Text="Email address" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="EmailBox" AutomationProperties.Name="Email address" />
        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,6" />
        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" />

        <StackPanel x:Name="MfaPanel" Visibility="Collapsed">
          <TextBlock Text="Verification code" FontWeight="SemiBold" Margin="0,16,0,6" />
          <TextBox x:Name="CodeBox" AutomationProperties.Name="Verification code" MaxLength="8" />
        </StackPanel>

        <CheckBox x:Name="RememberCheckBox" Content="Keep me signed in on this computer" IsChecked="True" Margin="0,16,0,0" />
        <TextBlock x:Name="MessageText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Height="42" IsDefault="True" Click="SignInButton_Click" />

        <Expander Header="Connection settings" Margin="0,16,0,0" Foreground="#506477">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Text="Oyama CRM address" Margin="0,0,0,5" />
            <TextBox x:Name="ApiUrlBox" Text="https://www.crm.partnertpcc.com" AutomationProperties.Name="Oyama CRM address" />
          </StackPanel>
        </Expander>
      </StackPanel>
      <TextBlock Grid.Row="1" HorizontalAlignment="Center" Text="OyamaPrint  •  A secure Oyama CRM companion" Foreground="#7A8998" FontSize="11" />
    </Grid>
  </Grid>
</Window>
