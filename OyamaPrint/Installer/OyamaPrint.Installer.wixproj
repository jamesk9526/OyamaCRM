<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <!-- CI/dev machines can lack the Windows Installer validation service. -->
    <SuppressValidation>true</SuppressValidation>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\..\artifacts\publish</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <OutputName>OyamaPrint-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>
</Project>
